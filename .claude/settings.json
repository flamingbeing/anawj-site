{
  "permissions": {
    "allow": [
      "Bash(git push -u origin claude/*)",
      "Bash(git push --force-with-lease origin claude/*)",
      "Bash(git push origin --delete claude/*)",
      "Bash(git push origin --delete codex/*)",
      "Bash(node tools/check.mjs*)",
      "Bash(node evals/test/*)",
      "Bash(node logbook/test/*)",
      "Bash(node nuh-roster/test/*)",
      "Bash(node prewarm/test/*)",
      "Bash(node worker/test/*)",
      "Bash(node hand-babies/test/*)",
      "Bash(tools/test-*.sh*)",
      "Bash(bash tools/test-*.sh*)",
      "Bash(node evals/tools/build-data.mjs*)",
      "Bash(python3 -m http.server*)",
      "Bash(npx wrangler deploy --dry-run*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git branch*)"
    ],
    "ask": [
      "Agent(codex:codex-rescue)",
      "Bash(codex *)",
      "Bash(node *codex-companion.mjs*)",
      "mcp__plugin_firebase_firebase",
      "Bash(firebase *)",
      "Bash(npx firebase-tools*)",
      "Bash(npx -y firebase-tools*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
