rules_version = '2';

// APMES Logbook and Evaluations (one Firebase project, apmes-logbook, has ONE rules file: this one).
// Paste the whole file into Firebase console → Firestore Database → Rules, then Publish. Never paste
// a rules file from another app over it: the last paste replaces everything.
// Least privilege: each person's logbook and cases are theirs alone; the app owner (listed in
// /owners, added by hand in the console, so ownership can be handed over there) can also read
// logbooks and cases and import cases. Admins (in /admins, also added in the console) manage the
// resident list and shared templates but cannot read anyone's logbook or cases. Summaries hold counts only (no case details) and are visible to admins and programme
// residents (a resident's own logbook names their rid, and residents/{rid} must carry their email).
// Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function me() {
      return request.auth.token.email.lower();
    }
    // access/{email}: roles kept in the app (People › Access), so they can be handed over without the console. A role
    // here counts the same as the older lists (owners/, admins/, pds/). 'admin' is Admin staff; 'pc' is a programme
    // coordinator and has the same powers as Admin staff (owner, 17 Oct 2026).
    function hasAccess(roles) {
      return exists(/databases/$(database)/documents/access/$(me()))
        && get(/databases/$(database)/documents/access/$(me())).data.roles.hasAny(roles);
    }
    function isAdmin() {
      return signedIn() && (exists(/databases/$(database)/documents/admins/$(me()))
        || hasAccess(['admin', 'pc']));
    }
    // the app owner: may read every logbook and its cases and import cases (never reflections,
    // images or the recycle bin). Written only from the console; hand over by swapping the entry.
    function isAppOwner() {
      return signedIn() && (exists(/databases/$(database)/documents/owners/$(me())) || hasAccess(['owner']));
    }
    // programme directors: a role separate from admin, so their permissions can be tuned on their own.
    // Today a PD can read the resident list, the counts summaries and every evaluation, and maintain
    // the resident and faculty lists and decide applications (evals); nothing else.
    function isPD() {
      return signedIn() && (exists(/databases/$(database)/documents/pds/$(me())) || hasAccess(['pd']));
    }
    function isOwner(email) {
      return signedIn() && email == me();
    }
    function optString(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max);
    }
    function optNumber(d, k) {
      return !(k in d) || d[k] == null || d[k] is number;
    }

    // access/{email} { name, roles, updatedAt, updatedBy }: who holds which role (owner, admin, pc, pd). Owners grant and
    // remove anything; Admin staff and PCs grant admin, pc and pd but never owner, and never change their own record.
    // Nobody can remove their own owner role (so an owner always remains), and nobody removes an owner but an owner.
    // accessLog/{id} is the append-only record of who changed what; the app writes it in the same batch.
    match /access/{email} {
      allow get: if isOwner(email);
      allow list: if isAdmin() || isPD() || isAppOwner();
      allow create: if email == email.lower() && validAccess(email, request.resource.data)
        && (isAppOwner() ? (email != me() || 'owner' in request.resource.data.roles)
                         : (isAdmin() && email != me() && !('owner' in request.resource.data.roles)));
      allow update: if email == email.lower() && validAccess(email, request.resource.data)
        && (isAppOwner() ? (email != me() || 'owner' in request.resource.data.roles)
                         : (isAdmin() && email != me() && !('owner' in request.resource.data.roles)
                            && !('owner' in resource.data.roles)));
      allow delete: if isAppOwner() ? email != me()
                                    : (isAdmin() && email != me() && !('owner' in resource.data.roles));
    }
    function validAccess(email, d) {
      return d.keys().hasOnly(['email', 'name', 'roles', 'updatedAt', 'updatedBy'])
        && d.email == email
        && optString(d, 'name', 200)
        && d.roles is list && d.roles.size() <= 5 && d.roles.hasOnly(['owner', 'admin', 'pc', 'pd', 'selection'])
        && d.updatedAt == request.time && d.updatedBy == me();
    }
    match /accessLog/{id} {
      allow read: if isAdmin() || isAppOwner();
      allow create: if (isAdmin() || isAppOwner())
        && request.resource.data.keys().hasOnly(['by', 'to', 'change', 'at'])
        && request.resource.data.by == me()
        && request.resource.data.to is string && request.resource.data.to.size() <= 200
        && request.resource.data.change is string && request.resource.data.change.size() <= 300
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // owners: written only from the console. A user may check their own entry.
    match /owners/{email} {
      allow get: if isOwner(email);
      allow list: if isAppOwner();
      allow write: if false;
    }

    // admins: written only from the console. A user may check their own entry.
    match /admins/{email} {
      allow get: if isOwner(email);
      allow list: if isAdmin();
      allow write: if false;
    }

    // programme directors: admins manage the list (or add them by hand in the console). A user may
    // check their own entry.
    match /pds/{email} {
      allow get: if isOwner(email);
      allow list: if isAdmin() || isPD();
      allow create, update: if isAdmin() && email == email.lower()
        && request.resource.data.keys().hasOnly(['name'])
        && optString(request.resource.data, 'name', 200);
      allow delete: if isAdmin();
    }

    // programme residents: admins manage the list; a user may read only the entry with their email
    // (the app queries residents where email == their email).
    match /residents/{rid} {
      allow read: if isAdmin() || isPD();
      allow get, list: if signedIn() && resource.data.email == me();
      // Any resident may read the ACTIVE residents (names and emails), so colleagues can be picked and found (owner, 17 Oct 2026:
      // "residents should be able to see each others emails and see the list of residents"). People on leave, graduated or
      // attrited stay hidden, and a list query must ask for status == 'ACTIVE'. Writes stay with admins and PDs.
      allow get, list: if resource.data.status == 'ACTIVE' && cccResident();
      // PDs may add residents and edit their name, status and year (the evals people lists), but never
      // overwrite an entry or move it to another email (that email is what grants the logbook's
      // programme access); only admins do that, and only admins delete
      allow create, update: if isAdmin() && validResident(rid, request.resource.data);
      allow create: if isPD() && validResident(rid, request.resource.data);
      allow update: if isPD() && validResident(rid, request.resource.data)
        && request.resource.data.email == resource.data.email;
      allow delete: if isAdmin();
    }
    function validResident(rid, d) {
      return d.keys().hasOnly(['rid', 'name', 'email', 'status', 'intake', 'rYear', 'smo'])
        && d.rid == rid
        && d.email is string && d.email == d.email.lower() && d.email.size() <= 200
        && optString(d, 'name', 200)
        && d.status in ['ACTIVE', 'ON LEAVE', 'SMO', 'GRADUATED', 'ATTRITED']
        && optNumber(d, 'intake')
        && (!('rYear' in d) || d.rYear == null || (d.rYear is int && d.rYear >= 1 && d.rYear <= 5))
        // years spent as an SMO after R3 (the logbook counts them as R3)
        && (!('smo' in d) || d.smo == null || (d.smo is int && d.smo >= 0 && d.smo <= 10));
    }

    // a person's logbook: theirs only; the app owner may read
    match /logbooks/{email} {
      allow read: if isOwner(email) || isAppOwner();
      allow create, update: if isOwner(email) && validLogbook(email, request.resource.data);
      allow delete: if isOwner(email);

      // cases: theirs only; the app owner may also read and write (import from the old form)
      match /cases/{caseId} {
        allow read: if isOwner(email) || isAppOwner();
        allow create, update: if (isOwner(email) || isAppOwner()) && validCase(caseId, request.resource.data);
        allow delete: if isOwner(email) || isAppOwner();
      }

      // case reflections: owner only (admins have no access)
      match /reflections/{id} {
        allow read, delete: if isOwner(email);
        allow create, update: if isOwner(email) && validReflection(id, request.resource.data);
      }

      // personal notes (More → Notes): owner only (admins, PDs and the app owner have no access); the app
      // keeps at most 100 (js/notepad.js)
      match /notes/{id} {
        allow read, delete: if isOwner(email);
        allow create, update: if isOwner(email) && validNote(id, request.resource.data);
      }
      // which days and cases have notes (meta/noteIndex), so the Logbook can mark them without reading a note: owner
      // only like the notes (it used to sit in the logbook doc's settings, which the app owner can read)
      match /meta/{id} {
        allow read, delete: if isOwner(email);
        allow create, update: if isOwner(email) && id == 'noteIndex' && validNoteIndex(request.resource.data);
      }

      // reflection figures (base64 JPEG/PNG, one per doc): owner only. Adding one needs a place on
      // the programme's residents list (isMember), so the shared database only holds residents' photos.
      match /images/{id} {
        allow read, delete: if isOwner(email);
        allow create, update: if isOwner(email) && isMember() && validImage(id, request.resource.data);
        // admins: only the figures of a portfolio marked ready (listed in its copy), to generate it
        allow get: if isAdmin() && exists(/databases/$(database)/documents/submissions/$(email))
          && id in get(/databases/$(database)/documents/submissions/$(email)).data.get('imageIds', []);
      }

      // ---- recycle bin (bin agent): deleted cases/reflections kept 30 days; owner only, admins no access ----
      // A binned reflection's figures stay in images/ until its bin entry is purged.
      match /bin/{id} {
        allow read, delete: if isOwner(email);
        allow create, update: if isOwner(email) && validBinEntry(id, request.resource.data);
      }

      // Google Form cases the resident deleted (js/form-inbox.js): just the case id and when, kept after the bin entry
      // goes, so an edited or re-sent Form response doesn't bring the case back; owner only
      match /formGone/{id} {
        allow read, delete: if isOwner(email);
        allow create, update: if isOwner(email) && id.matches('^imp_form~003a[A-Za-z0-9_-]{1,120}$')
          && request.resource.data.keys().hasOnly(['id', 'deletedAt']) && request.resource.data.id == id
          && request.resource.data.deletedAt is number;
      }
    }
    function validLogbook(email, d) {
      return d.keys().hasOnly(['email', 'name', 'rid', 'settings', 'templates', 'profile', 'plan', 'updatedAt'])
        && d.email == email
        && optString(d, 'rid', 40)
        && optNumber(d, 'updatedAt')
        && optString(d, 'name', 200)
        && (!('templates' in d) || (d.templates is list && d.templates.size() <= 100))
        && (!('settings' in d) || d.settings is map)
        // cases planned for a later day (paste tomorrow's list, confirm after)
        && (!('plan' in d) || (d.plan is list && d.plan.size() <= 100))
        // portfolio Section 1 details (js/profile.js cleanProfile caps lists and strings)
        && (!('profile' in d) || (d.profile is map && d.profile.size() <= 30));
    }
    function validBinEntry(id, d) {
      return d.keys().hasOnly(['id', 'kind', 'data', 'deletedAt'])
        && d.keys().hasAll(['id', 'kind', 'data', 'deletedAt'])
        && d.id == id && id.size() <= 120
        && d.kind in ['reflection', 'case', 'note']
        && d.data is map && d.data.size() <= 40
        && d.deletedAt is number;
    }
    // ---- end recycle bin ----
    function sec(m, k) { return !(k in m) || (m[k] is string && m[k].size() <= 20000); }
    // lists can't be looped in rules: their sizes are capped here and their contents by reflections.js
    function validReflection(id, d) {
      return d.keys().hasOnly(['id', 'headingId', 'subId', 'initials', 'date', 'jr', 'diagnosis', 'title', 'summary', 'points', 'figures', 'references', 'sections', 'caseId', 'source', 'status', 'export', 'createdAt', 'updatedAt'])
        && d.id == id
        && (!('export' in d) || d.export is bool)   // false: left out of the portfolio export
        && (!('source' in d) || d.source in ['app', 'word'])
        && d.headingId is string && d.headingId.size() <= 40
        && (!('subId' in d) || d.subId == null || (d.subId is string && d.subId.size() <= 40))
        && optString(d, 'initials', 20)
        && (!('date' in d) || d.date == null || (d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('jr' in d) || d.jr is bool)
        && optString(d, 'diagnosis', 2000)
        && optString(d, 'title', 300)
        && optString(d, 'summary', 20000)
        && (!('points' in d) || (d.points is list && d.points.size() <= 15))
        && (!('figures' in d) || (d.figures is list && d.figures.size() <= 10))
        && (!('references' in d) || (d.references is list && d.references.size() <= 30))
        && (!('caseId' in d) || d.caseId == null || (d.caseId is string && d.caseId.size() <= 200))
        && d.status in ['draft', 'complete']
        && (!('sections' in d) || (d.sections is map
          && d.sections.keys().hasOnly(['description', 'thoughts', 'evaluation', 'analysis', 'conclusions', 'action', 'further'])
          && sec(d.sections, 'description') && sec(d.sections, 'thoughts') && sec(d.sections, 'evaluation')
          && sec(d.sections, 'analysis') && sec(d.sections, 'conclusions') && sec(d.sections, 'action') && sec(d.sections, 'further')))
        && optNumber(d, 'createdAt') && optNumber(d, 'updatedAt');
    }
    function validImage(id, d) {
      return d.keys().hasOnly(['id', 'data', 'mime', 'w', 'h', 'createdAt'])
        && d.id == id
        && d.data is string && d.data.size() < 750000
        && d.mime in ['image/jpeg', 'image/png']
        && optNumber(d, 'w') && optNumber(d, 'h') && optNumber(d, 'createdAt');
    }
    function validNoteIndex(d) {
      return d.keys().hasOnly(['days', 'cases', 'n', 'updatedAt'])
        && d.days is list && d.days.size() <= 100
        && d.cases is list && d.cases.size() <= 100
        && d.n is int && d.n >= 0
        && optNumber(d, 'updatedAt');
    }
    function validNote(id, d) {
      return d.keys().hasOnly(['id', 'date', 'title', 'body', 'caseId', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['id', 'body'])
        && d.id == id && id.size() <= 100
        && d.body is string && d.body.size() <= 20000
        && optString(d, 'title', 200)
        && optString(d, 'caseId', 200)
        && (!('date' in d) || d.date == null || (d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && optNumber(d, 'createdAt') && optNumber(d, 'updatedAt');
    }
    function validCase(caseId, d) {
      return d.keys().hasOnly(['id', 'date', 'dateText', 'initials', 'details', 'cats', 'createdAt', 'updatedAt', 'source', 'importKey', 'reflectionId', 'reflectTag', 'tags'])
        && d.id == caseId
        && d.details is string && d.details.size() <= 2000
        && d.cats is list && d.cats.size() <= 40
        && (!('date' in d) || d.date == null || (d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && optString(d, 'dateText', 200)
        && optString(d, 'initials', 20)
        && optString(d, 'importKey', 200)
        && optString(d, 'reflectionId', 200)
        && (!('reflectTag' in d) || d.reflectTag is bool)
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 20))
        && (!('source' in d) || d.source in ['app', 'import', 'paste', 'sheet', 'form'])
        && optNumber(d, 'createdAt') && optNumber(d, 'updatedAt');
    }

    // counts per resident for benchmarking: admins and programme residents read; admins or the
    // resident write. A resident's own write must carry the name and intake on the programme list.
    // ready portfolios: a copy of what the portfolio needs (ticked reflections, their figures, Section 1,
    // Section 4 counts), written by the resident when they mark it ready; admins read it to generate the
    // portfolio. Admins still can't read logbooks, cases or the resident's own reflections.
    match /submissions/{email} {
      allow read: if isOwner(email) || isAdmin();
      allow delete: if isOwner(email);
      allow create, update: if isOwner(email) && validSubmission(email, request.resource.data);
      match /reflections/{id} {
        allow read: if isOwner(email) || isAdmin();
        allow delete: if isOwner(email);
        allow create, update: if isOwner(email) && validReflection(id, request.resource.data);
      }
    }
    function validSubmission(email, d) {
      return d.keys().hasOnly(['email', 'rid', 'name', 'intake', 'rYear', 'smo', 'readyAt', 'updatedAt', 'fp', 'count', 'profile', 'counts', 'imageIds'])
        && (!('imageIds' in d) || (d.imageIds is list && d.imageIds.size() <= 1000))
        && d.email == email
        && optString(d, 'name', 200) && optString(d, 'fp', 100)
        && (!('rid' in d) || d.rid == null || (d.rid is string && d.rid.size() <= 40))
        && d.count is int && d.count >= 0 && d.count <= 500
        && (!('profile' in d) || d.profile == null || (d.profile is map && d.profile.size() <= 30))
        && d.counts is map && d.counts.size() <= 100;
    }

    // the counts summaries (counts per tag, reflections per heading, never case details): admins, PDs, programme
    // residents and active faculty (the Faculty / PCs profile's Case logs; owner, Oct 2026: counts are no secret)
    match /summaries/{rid} {
      allow read: if isAdmin() || isPD() || isMember() || isActiveFaculty(me());
      allow create, update: if validSummary(rid, request.resource.data)
        && (isAdmin() || (isResident(rid) && ownSummary(rid, request.resource.data)));
      allow delete: if isAdmin();
    }
    function isResident(rid) {
      return signedIn()
        && exists(/databases/$(database)/documents/residents/$(rid))
        && get(/databases/$(database)/documents/residents/$(rid)).data.email == me();
    }
    // signed in and on the programme list: the rid named in their logbook belongs to their email
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/logbooks/$(me()))
        && get(/databases/$(database)/documents/logbooks/$(me())).data.get('rid', null) is string
        && get(/databases/$(database)/documents/residents/$(get(/databases/$(database)/documents/logbooks/$(me())).data.rid)).data.email == me();
    }
    function ownSummary(rid, d) {
      return (d.get('name', '') == get(/databases/$(database)/documents/residents/$(rid)).data.get('name', '')
          || (d.get('name', '') == '' && get(/databases/$(database)/documents/residents/$(rid)).data.get('name', null) == null))
        && d.get('intake', null) == get(/databases/$(database)/documents/residents/$(rid)).data.get('intake', null);
    }
    function validSummary(rid, d) {
      return d.keys().hasOnly(['rid', 'name', 'intake', 'rYear', 'smo', 'counts', 'total', 'reflections', 'reflectionsTotal', 'updatedAt'])
        && d.rid == rid
        && d.counts is map && d.counts.size() <= 100
        && d.total is int && d.total >= 0 && d.total < 100000
        && optString(d, 'name', 200)
        && optNumber(d, 'intake') && optNumber(d, 'updatedAt')
        && (!('rYear' in d) || d.rYear == null || (d.rYear is int && d.rYear >= 1 && d.rYear <= 5))
        && (!('reflectionsTotal' in d) || d.reflectionsTotal == null || (d.reflectionsTotal is int && d.reflectionsTotal >= 0 && d.reflectionsTotal < 10000))
        && (!('reflections' in d) || d.reflections is map)
        && (!('smo' in d) || d.smo is bool);   // an SMO (Totals shows them with R3)
    }

    // which old-form rows have been imported: the app owner only
    match /imports/{rid} {
      allow read, write: if isAppOwner();
    }

    // the Google Form inbox (form-inbox.js): residents who prefer the old Google Form keep using it. The Form's Apps
    // Script signs in as a bot account (email and password; never email-verified, so signedIn() and everything that
    // builds on it stay closed to it) listed by uid in /formBots, which is written only from the console. The bot may
    // only add or replace entries, never read or delete them. Each resident reads and deletes only the entries
    // carrying their own (Google-verified) email: the app turns them into cases in their logbook, then deletes them.
    function isFormBot() {
      return request.auth != null && exists(/databases/$(database)/documents/formBots/$(request.auth.uid));
    }
    function validFormEntry(id, d) {
      return d.keys().hasOnly(['id', 'email', 'date', 'dateText', 'details', 'labels', 'submittedAt'])
        && d.id == id && id.matches('^[A-Za-z0-9_-]{1,120}$')
        && d.email is string && d.email.size() > 3 && d.email.size() <= 200 && d.email == d.email.lower()
        && (!('date' in d) || d.date == null || (d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && optString(d, 'dateText', 200)
        && d.details is string && d.details.size() <= 2000
        && d.labels is list && d.labels.size() <= 40
        && d.submittedAt is number;
    }
    match /formBots/{uid} {
      allow read, write: if false;
    }
    match /formInbox/{id} {
      allow create, update: if isFormBot() && validFormEntry(id, request.resource.data);
      allow read, delete: if signedIn() && resource.data.email == me();
    }

    // new app cases for the old Google Form's response sheet (js/sheet-outbox.js; form-script/Outbox.gs; teething phase).
    // A programme resident adds an entry for their own new case (once: no update); the sheet's script, signing in as the
    // same bot account as the Form inbox, lists the entries, appends each to the sheet and deletes it. The resident may
    // delete their own entry too (a case removed before the script picked it up). Nobody else reads any of it.
    function validOutbox(id, d) {
      return d.keys().hasOnly(['id', 'email', 'rid', 'date', 'dateText', 'initials', 'details', 'cats', 'createdAt'])
        && d.id == id && id.matches('^[A-Za-z0-9_-]{1,120}$')
        && d.email is string && d.email == d.email.lower() && d.email.size() <= 200
        && d.rid is string && d.rid.size() <= 40
        && (!('date' in d) || d.date == null || (d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && optString(d, 'dateText', 200) && optString(d, 'initials', 20)
        && d.details is string && d.details.size() <= 2000
        && d.cats is list && d.cats.size() <= 40
        && d.createdAt is number;
    }
    match /sheetOutbox/{id} {
      allow create: if isMember() && validOutbox(id, request.resource.data)
        && request.resource.data.email == me()
        && request.resource.data.rid == get(/databases/$(database)/documents/logbooks/$(me())).data.rid;
      allow read: if isFormBot();
      // a resident takes back their own entry when the case is deleted; one that is already gone (the sheet script took it,
      // or the case never had one) is nothing to delete, so that is allowed too (refused, it showed a false "could not be
      // synced" when the delete was sent late, offline)
      allow delete: if isFormBot() || (signedIn() && (resource == null || resource.data.email == me()));
    }

    // private feedback (logbook More → Send feedback): never a public GitHub issue, as a report can mention a case or
    // a colleague. Anyone signed in may send one, as themselves, with the server's time and status 'new'; nobody but
    // the app owner reads it. The owner marks it done (only the status changes) or deletes it. No email is stored.
    match /feedback/{id} {
      allow create: if signedIn() && id.size() <= 40
        && validFeedback(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAppOwner();
      allow update: if isAppOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'done'];
    }
    function validFeedback(d) {
      return d.keys().hasOnly(['uid', 'text', 'doing', 'screen', 'version', 'ua', 'status', 'createdAt'])
        && d.keys().hasAll(['uid', 'text', 'screen', 'version', 'ua', 'status', 'createdAt'])
        && d.uid is string && d.uid.size() <= 128
        && d.text is string && d.text.size() > 0 && d.text.size() <= 2000
        && (!('doing' in d) || (d.doing is string && d.doing.size() <= 300))
        && d.screen is string && d.screen.size() <= 40
        && d.version is string && d.version.size() <= 60
        && d.ua is string && d.ua.size() <= 200;
    }

    // templates offered to everyone: admins write
    match /sharedTemplates/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['id', 'name', 'cats', 'details'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.cats is list && request.resource.data.cats.size() <= 40
        && optString(request.resource.data, 'details', 2000);
      allow delete: if isAdmin();
    }

    // ---- portfolio template (word-export): the blank APMES portfolio, base64 in ≤700 KB chunks ----
    // category display names and pill names (display only; exports keep the official names)
    match /config/categoryNames {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['names', 'updatedAt'])
        && request.resource.data.names is map && request.resource.data.names.size() <= 200;
    }
    // rids left off Totals (attrited residents); admins keep it in step with the residents list
    match /config/totalsHidden {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['rids', 'updatedAt'])
        && request.resource.data.rids is list && request.resource.data.rids.size() <= 500;
    }
    match /config/portfolioTemplate {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['parts', 'size', 'uploadedAt'])
        && request.resource.data.parts is int && request.resource.data.parts >= 1 && request.resource.data.parts <= 20;
      allow delete: if isAdmin();
    }
    match /config/{part} {
      allow read: if signedIn() && part.matches('portfolioTemplate_part[0-9]+');
      allow write: if isAdmin() && part.matches('portfolioTemplate_part[0-9]+')
        && request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 716800;
      allow delete: if isAdmin() && part.matches('portfolioTemplate_part[0-9]+');
    }
    // ==== Evaluations (/evals): workplace-based assessments (DOPS, Mini-CEX, EBD) ====
    // The resident starts one and names an assessor from the faculty list; the assessor (signed in
    // with that email) fills it in, then submits or declines; PDs and admins read all of them.
    // Residents never see each other's, and an assessor only sees the ones assigned to them.
    // A submitted evaluation can be edited by its assessor for 15 min, then it is locked (admins can
    // reopen). Shared keys with the logbook: rid, date ('YYYY-MM-DD'), source.
    // Times (requestedAt, submittedAt, declinedAt, seenAt, chasedAt) are client ms numbers; the
    // request, submit and decline times may not be in the future (5 min slack for clocks) or more
    // than 30 days old: an assessor may submit offline and sync hours later.
    function isActiveFaculty(e) {
      return e is string
        && exists(/databases/$(database)/documents/faculty/$(e))
        && get(/databases/$(database)/documents/faculty/$(e)).data.get('status', '') == 'ACTIVE';
    }
    function notFuture(t) {
      return t is number && t <= request.time.toMillis() + 300000 && t >= request.time.toMillis() - 2592000000;
    }
    match /evaluations/{id} {
      // the assessor sees it once it is sent (not the resident's unsent draft)
      allow read: if isAdmin() || isPD()
        || (signedIn() && (resource.data.residentEmail == me()
            || (resource.data.assessorEmail == me() && resource.data.status != 'draft')));

      // the resident: create as draft or requested, for themselves, naming an active faculty member
      // (never themselves), never pre-filling the assessment or the outcome
      allow create: if signedIn() && request.resource.data.get('residentEmail', '') == me()
        && validEval(id, request.resource.data)
        && request.resource.data.status in ['draft', 'requested']
        && !request.resource.data.keys().hasAny(['assessment', 'metrics', 'submittedAt', 'declineReason', 'declinedAt', 'seenAt'])
        && (request.resource.data.status == 'draft' || notFuture(request.resource.data.get('requestedAt', null)))
        && validCaseCard(request.resource.data.get('request', {}))
        && isResident(request.resource.data.rid)
        && isActiveFaculty(request.resource.data.assessorEmail);

      // updates: the document must stay valid, and one of the branches below must allow the change.
      // Cheap who-is-asking checks come first: validEval is long, and the rules engine allows 1000
      // expressions per request.
      allow update: if isAdmin() && validEval(id, request.resource.data);
      allow update: if signedIn() && (resource.data.residentEmail == me() || resource.data.assessorEmail == me())
        && validEval(id, request.resource.data)
        && (residentEdits() || residentReassigns() || residentSees() || assessorWrites() || assessorCorrects());

      // never delete resident data: only a resident's own unsent draft (never one an assessor has
      // started), or an admin
      allow delete: if isAdmin()
        || (signedIn() && resource.data.residentEmail == me() && resource.data.status == 'draft'
            && !resource.data.keys().hasAny(['assessment', 'submittedAt', 'declinedAt']));

      // the assessor's comments meant only for the PD (optional): never readable by the resident.
      // Each note carries its author: after a decline and reassign, the new assessor can't read or
      // overwrite the old assessor's note (older notes without an author: the current assessor, as before).
      match /private/{doc} {
        allow read: if isAdmin() || isPD()
          || (signedIn() && resource.data.get('author', '') == me())
          || (signedIn() && !('author' in resource.data)
              && get(/databases/$(database)/documents/evaluations/$(id)).data.assessorEmail == me());
        allow write: if signedIn()
          && get(/databases/$(database)/documents/evaluations/$(id)).data.assessorEmail == me()
          && get(/databases/$(database)/documents/evaluations/$(id)).data.status == 'requested'
          && (resource == null || resource.data.get('author', me()) == me())
          && request.resource.data.keys().hasOnly(['comments', 'updatedAt', 'author'])
          && request.resource.data.get('author', '') == me()
          && optString(request.resource.data, 'comments', 5000) && optNumber(request.resource.data, 'updatedAt');
      }
    }
    // Update branches (rs = the document after the write). Who-is-asking checks come first.
    // The resident: edit their request until it is submitted (and nudge: chasedAt). The assessor,
    // form and item can change only before an assessment has been started (so a half-written
    // assessment never moves to someone else); a new assessor must be on the faculty list.
    function residentEdits() {
      return resource.data.residentEmail == me()
        && resource.data.status in ['draft', 'requested']
        && request.resource.data.status in ['draft', 'requested', 'cancelled']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['request', 'status', 'assessorEmail', 'assessorName', 'formId', 'formVersion', 'epa', 'date', 'caseId', 'updatedAt', 'requestedAt',
                       'itemId', 'itemText', 'tool', 'level', 'caseKey', 'catalogueVersion', 'chasedAt', 'metrics'])
        // metrics (the old assessor's open/answer times) may only be removed, when the assessor changes
        && !('metrics' in request.resource.data && request.resource.data.diff(resource.data).affectedKeys().hasAny(['metrics']))
        // once the assessor has started, what is being assessed stays put (the scores belong to that item)
        && (resource.data.get('assessment', {}).size() == 0
            || (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['assessorEmail', 'formId', 'itemId', 'tool',
                    'epa', 'level', 'itemText', 'formVersion', 'request', 'date', 'caseKey', 'catalogueVersion'])
                && request.resource.data.status != 'draft'))
        && (request.resource.data.assessorEmail == resource.data.assessorEmail || isActiveFaculty(request.resource.data.assessorEmail))
        && (request.resource.data.get('request', {}) == resource.data.get('request', {}) || validCaseCard(request.resource.data.get('request', {})));
    }
    // The resident, after a decline: send it to a new assessor on the faculty list (the old partial
    // assessment and metrics are removed, the decline reason stays as history), or cancel it.
    function residentReassigns() {
      return resource.data.residentEmail == me()
        && resource.data.status == 'declined'
        && ((request.resource.data.status == 'requested'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'assessorEmail', 'assessorName', 'updatedAt', 'requestedAt', 'assessment', 'metrics', 'chasedAt', 'request', 'date'])
              && !request.resource.data.keys().hasAny(['assessment', 'metrics'])
              && (request.resource.data.get('request', {}) == resource.data.get('request', {}) || validCaseCard(request.resource.data.get('request', {})))
              && request.resource.data.assessorEmail != resource.data.assessorEmail
              && isActiveFaculty(request.resource.data.assessorEmail))
          || (request.resource.data.status == 'cancelled'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])));
    }
    // The resident, once submitted: may only mark the feedback as seen.
    function residentSees() {
      return resource.data.residentEmail == me()
        && resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt', 'updatedAt']);
    }
    // The assessor: fill in (and save) the assessment while it is requested, then submit or decline.
    function assessorWrites() {
      return resource.data.assessorEmail == me()
        && resource.data.status == 'requested'
        && request.resource.data.get('assessment', {}) is map
        && ((request.resource.data.status == 'requested'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assessment', 'metrics', 'assessorName', 'updatedAt']))
          || (request.resource.data.status == 'submitted'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assessment', 'metrics', 'assessorName', 'updatedAt', 'status', 'submittedAt'])
              && notFuture(request.resource.data.submittedAt))
          // a decline drops any partial answers (the resident would otherwise see half a score sheet)
          || (request.resource.data.status == 'declined'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assessment', 'metrics', 'assessorName', 'updatedAt', 'status', 'declineReason', 'declinedAt'])
              && !request.resource.data.keys().hasAny(['assessment', 'metrics'])
              && validDecline(request.resource.data.get('declineReason', null))
              && notFuture(request.resource.data.declinedAt)));
    }
    // The assessor: may correct the answers for 15 min after submitting.
    function assessorCorrects() {
      return resource.data.assessorEmail == me()
        && resource.data.status == 'submitted'
        && resource.data.get('submittedAt', null) is number
        && request.time.toMillis() < resource.data.submittedAt + 900000
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assessment', 'updatedAt'])
        && request.resource.data.get('assessment', {}) is map;
    }
    function validDecline(r) {
      return r is map && r.keys().hasOnly(['code', 'text'])
        && r.get('code', null) is string && r.code.size() > 0 && r.code.size() <= 40
        && optString(r, 'text', 2000);
    }
    // the case card: no names or free-form identifiers beyond short fields and a short note
    function validCaseCard(r) {
      return r is map && r.keys().hasOnly(['date', 'location', 'initials', 'ageBand', 'gender', 'coManaged', 'notes'])
        && optString(r, 'date', 10) && optString(r, 'location', 100) && optString(r, 'initials', 3)
        && optString(r, 'ageBand', 20) && optString(r, 'gender', 20) && optString(r, 'notes', 1000);
    }
    function validEval(id, d) {
      return d.keys().hasOnly(['id', 'rid', 'residentEmail', 'residentName', 'assessorEmail', 'assessorName',
          'formId', 'formVersion', 'epa', 'date', 'source', 'status', 'request', 'assessment', 'caseId',
          'createdAt', 'updatedAt', 'requestedAt', 'submittedAt',
          'itemId', 'itemText', 'tool', 'level', 'caseKey', 'catalogueVersion',
          'declineReason', 'declinedAt', 'seenAt', 'chasedAt', 'metrics'])
        && d.id == id
        && d.rid is string && d.rid.size() <= 40
        && d.residentEmail is string && d.residentEmail == d.residentEmail.lower() && d.residentEmail.size() <= 200
        && d.assessorEmail is string && d.assessorEmail == d.assessorEmail.lower() && d.assessorEmail.size() <= 200
        && d.assessorEmail != d.residentEmail
        && d.formId is string && d.formId.size() <= 60
        && d.source == 'evals'
        && d.status in ['draft', 'requested', 'submitted', 'declined', 'cancelled']
        && (d.date == null || (d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && optString(d, 'residentName', 200) && optString(d, 'assessorName', 200)
        && optString(d, 'epa', 20) && optString(d, 'caseId', 200)
        && optString(d, 'itemId', 60) && optString(d, 'itemText', 600) && optString(d, 'caseKey', 100) && optString(d, 'catalogueVersion', 40)
        && (!('tool' in d) || d.tool == null || d.tool in ['DOPS', 'MiniCEX', 'EBD'])
        && optNumber(d, 'level')
        && optNumber(d, 'formVersion') && optNumber(d, 'createdAt') && optNumber(d, 'updatedAt')
        && optNumber(d, 'requestedAt') && optNumber(d, 'submittedAt')
        && optNumber(d, 'declinedAt') && optNumber(d, 'seenAt') && optNumber(d, 'chasedAt')
        && (!('declineReason' in d) || d.declineReason == null || validDecline(d.declineReason))
        && (!('metrics' in d) || (d.metrics is map && d.metrics.size() <= 10))
        && (!('request' in d) || d.request is map)
        && (!('assessment' in d) || (d.assessment is map && d.assessment.size() <= 80));
    }

    // faculty list (who may be named as an assessor): admins and PDs maintain it. Read by admins,
    // PDs, faculty (any status) and programme residents; anyone may check their own entry.
    // Residents are keyed by rid, so a resident proves themselves through members/{email} (below).
    match /faculty/{email} {
      allow get: if isOwner(email);
      allow read: if isAdmin() || isPD()
        || (signedIn() && exists(/databases/$(database)/documents/faculty/$(me())))
        || (signedIn() && exists(/databases/$(database)/documents/members/$(me()))
            && isResident(get(/databases/$(database)/documents/members/$(me())).data.rid));
      allow create, update: if (isAdmin() || isPD()) && email == email.lower() && validFaculty(email, request.resource.data);
      allow delete: if isAdmin();
    }
    function validFaculty(email, d) {
      return d.keys().hasOnly(['email', 'name', 'status', 'updatedAt', 'core', 'ccc', 'workEmail'])
        && d.email == email
        && optString(d, 'name', 200)
        && d.status in ['ACTIVE', 'INACTIVE']
        && (!('core' in d) || d.core is bool) && (!('ccc' in d) || d.ccc is bool)
        && optString(d, 'workEmail', 200)
        && optNumber(d, 'updatedAt');
    }

    // members/{email}: { rid } — an email-keyed pointer to the person's resident entry, written by the
    // resident themselves (the rid must carry their email), so rules can check "is a resident" by
    // email. It grants nothing on its own: every use re-checks residents/{rid}.
    match /members/{email} {
      allow get: if isOwner(email);
      allow list: if isAdmin();
      allow create, update: if isOwner(email) && email == email.lower()
        && request.resource.data.keys().hasOnly(['rid'])
        && request.resource.data.rid is string && request.resource.data.rid.size() <= 40
        && isResident(request.resource.data.rid);
      allow delete: if isOwner(email) || isAdmin();
    }

    // applications to join as faculty or resident: the applicant writes their own while pending (or
    // applies again after a rejection);
    // admins and PDs read them all and approve or reject (the app then adds the faculty/resident entry)
    match /applications/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow read: if isAdmin() || isPD();
      allow create: if signedIn() && uid == request.auth.uid
        && validApplication(uid, request.resource.data)
        && request.resource.data.email == me()
        && request.resource.data.status == 'pending'
        && !request.resource.data.keys().hasAny(['decidedAt', 'decidedBy']);
      allow update: if signedIn() && uid == request.auth.uid
        && resource.data.status in ['pending', 'rejected']
        && validApplication(uid, request.resource.data)
        && request.resource.data.email == me()
        && request.resource.data.status == 'pending'
        && !request.resource.data.keys().hasAny(['decidedAt', 'decidedBy']);
      allow update: if (isAdmin() || isPD())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy'])
        && validApplication(uid, request.resource.data);
      allow delete: if isAdmin();
    }
    function validApplication(uid, d) {
      return d.keys().hasOnly(['uid', 'email', 'name', 'role', 'note', 'status', 'createdAt', 'decidedAt', 'decidedBy'])
        && d.uid == uid
        && d.email is string && d.email == d.email.lower() && d.email.size() <= 200
        && optString(d, 'name', 200) && optString(d, 'note', 1000)
        && d.role in ['resident', 'faculty']
        && d.status in ['pending', 'approved', 'rejected']
        && optNumber(d, 'createdAt') && optNumber(d, 'decidedAt') && optString(d, 'decidedBy', 200);
    }

    // form definitions (Mini-CEX, DOPS, EPA entrustment, …): everyone signed in reads; admins write
    match /evalForms/{formId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Selection 360 (selection/): confidential feedback on residency applicants, by residents and faculty.
    // A round is selection/{cycle} (title, applicants, open or closed): admins and PDs write it; anyone who may answer
    // (an admin, a PD, listed faculty, a resident) reads it. Each respondent writes only their own response,
    // selection/{cycle}/responses/{email}, while the round is open, and reads only that. PDs and the committee
    // (selectionCommittee/{email}, kept by admins and PDs) read every response. Admins do not read responses unless
    // they are PDs or on the committee (owner, 17 Oct 2026: "committee and PDs").
    // a guest: signed in by the applicants app's passcode (worker/guest.js), a custom token with claim guest and no email. It can read a
    // round and its photos and write its own response (document guest-<uid>), nothing else: signedIn() needs a verified email, so every
    // other rule in this file turns a guest away.
    function isPasscode() {
      return request.auth != null && request.auth.token.guest == true && !('email' in request.auth.token);
    }
    // role claim: guest (sends feedback), setup (sets a round up), committee (reads the responses). Tokens issued before roles existed have none: guests.
    function isGuest() {
      return isPasscode() && (!('role' in request.auth.token) || request.auth.token.role == 'guest');
    }
    function isSetupCode() {
      return isPasscode() && request.auth.token.get('role', '') == 'setup';
    }
    function isCommitteeCode() {
      return isPasscode() && request.auth.token.get('role', '') == 'committee';
    }
    // who sets a round up: Admin staff, PDs, and people given the Applicants set-up role (access/, edited on the app's Set up page or in People)
    function selStaff() {
      return isAdmin() || isPD() || isSetupCode() || (signedIn() && hasAccess(['selection']));
    }
    function selMayAnswer() {
      return isGuest() || isCommitteeCode() || selStaff()
        || (signedIn() && exists(/databases/$(database)/documents/faculty/$(me())))
        || (signedIn() && exists(/databases/$(database)/documents/members/$(me()))
            && isResident(get(/databases/$(database)/documents/members/$(me())).data.rid));
    }
    function selCommittee() {
      return signedIn() && exists(/databases/$(database)/documents/selectionCommittee/$(me()));
    }
    match /selectionCommittee/{email} {
      allow get: if isOwner(email);
      allow list: if isAdmin() || isPD();
      allow create, update: if (isAdmin() || isPD()) && email == email.lower()
        && request.resource.data.keys().hasOnly(['name'])
        && optString(request.resource.data, 'name', 200);
      allow delete: if isAdmin() || isPD();
    }
    // the three passcodes (guest, setup, committee), changed on the app's Set up page: selectionCodes/{role} { code, updatedAt }.
    // Admin staff and PDs read, set and clear them (a cleared one falls back to the Worker secret of the same name). The Worker
    // (worker/guest.js) reads them with a service sign-in that carries claim codesReader and no email; nobody else, guests included.
    function isCodesReader() {
      return request.auth != null && request.auth.token.get('codesReader', false) == true && !('email' in request.auth.token);
    }
    match /selectionCodes/{role} {
      allow read: if isAdmin() || isPD() || isCodesReader();
      allow create, update: if (isAdmin() || isPD()) && role in ['guest', 'setup', 'committee']
        && request.resource.data.keys().hasOnly(['code', 'updatedAt'])
        && request.resource.data.code is string && request.resource.data.code.size() >= 6 && request.resource.data.code.size() <= 100
        && optNumber(request.resource.data, 'updatedAt');
      allow delete: if isAdmin() || isPD();
    }
    match /selection/{cycle} {
      allow read: if selMayAnswer();
      allow create, update: if selStaff() && cycle.size() <= 20 && validSelRound(cycle, request.resource.data);
      allow delete: if isAdmin() || isPD();
      // applicants' passport photos (a few KB of base64 JPEG each): everyone who may answer reads; admins and PDs keep them
      match /photos/{aid} {
        allow read: if selMayAnswer();
        allow create, update: if selStaff() && aid.size() <= 20 && validSelPhoto(request.resource.data);
        allow delete: if selStaff();
      }
      match /responses/{email} {
        allow get: if isOwner(email) || (isGuest() && email == 'guest-' + request.auth.uid);
        allow read: if isPD() || selCommittee() || isCommitteeCode();
        allow create, update: if ((isOwner(email) && email == email.lower()) || (isGuest() && email == 'guest-' + request.auth.uid)) && selMayAnswer()
          && get(/databases/$(database)/documents/selection/$(cycle)).data.status == 'open'
          && validSelResponse(email, request.resource.data);
        allow delete: if isPD();
      }
    }
    function validSelRound(cycle, d) {
      return d.keys().hasOnly(['cycle', 'title', 'status', 'applicants', 'questions', 'form', 'mirror', 'updatedAt'])
        && d.cycle == cycle
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.status in ['open', 'closed']
        && d.applicants is list && d.applicants.size() >= 1 && d.applicants.size() <= 200
        && (!('questions' in d) || (d.questions is list && d.questions.size() >= 1 && d.questions.size() <= 10))
        && (!('mirror' in d) || d.mirror is bool)
        && (!('form' in d) || (d.form is map && d.form.keys().hasOnly(['id', 'nameEntry']) && d.form.id is string && d.form.id.size() <= 80 && d.form.nameEntry is int))
        && optNumber(d, 'updatedAt');
    }
    function validSelPhoto(d) {
      return d.keys().hasOnly(['jpeg', 'updatedAt'])
        && d.jpeg is string && d.jpeg.size() > 0 && d.jpeg.size() <= 80000
        && optNumber(d, 'updatedAt');
    }
    function validSelResponse(email, d) {
      return d.keys().hasOnly(['email', 'name', 'answers', 'updatedAt'])
        && d.email == email
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.answers is map && d.answers.size() <= 200
        && d.updatedAt == request.time;
    }

    // CCC 360 (ccc/): what the programme coordinators (PCs) collect before a CCC meeting. A round is ccc/{round} (title,
    // open or closed, deadline): PDs, Admin staff and PCs write it; residents and those staff read it. Each resident writes
    // only their own scholarly-project entry, ccc/{round}/entries/{email}, and their own nominees for multisource feedback,
    // ccc/{round}/msf/{email}, while the round is open. Nominees are third parties' contact details, so they sit apart from
    // the projects so they can be deleted on their own after the round (the app deletes them 60 days after closing).
    // PDs, Admin staff and PCs (access/{email}, People › Access; a PC has Admin staff's powers) read every entry and
    // nominee list. ccc/{round}/review/{email} holds their marks on one resident's nominees.
    function cccResident() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(me()))
        && isResident(get(/databases/$(database)/documents/members/$(me())).data.rid);
    }
    function cccStaff() {
      return isPD() || isAdmin();
    }
    function cccOpen(round) {
      return get(/databases/$(database)/documents/ccc/$(round)).data.status == 'open';
    }
    match /ccc/{round} {
      allow read: if cccStaff() || cccResident();
      allow create, update: if cccStaff() && round.size() <= 20 && validCccRound(round, request.resource.data);
      allow delete: if cccStaff();
      match /entries/{email} {
        allow get: if isOwner(email);
        allow read: if cccStaff();
        allow create, update: if isOwner(email) && email == email.lower() && cccResident() && cccOpen(round)
          && validCccEntry(email, request.resource.data);
        allow delete: if cccStaff();
      }
      match /msf/{email} {
        allow get: if isOwner(email);
        allow read: if cccStaff();
        allow create, update: if isOwner(email) && email == email.lower() && cccResident() && cccOpen(round)
          && validCccMsf(email, request.resource.data);
        allow delete: if cccStaff() || (isOwner(email) && cccOpen(round));
      }
      match /review/{email} {
        allow read: if cccStaff();
        allow create, update: if cccStaff() && email == email.lower()
          && request.resource.data.keys().hasOnly(['email', 'marks', 'updatedAt'])
          && request.resource.data.email == email
          && request.resource.data.marks is map && request.resource.data.marks.size() <= 40
          && optNumber(request.resource.data, 'updatedAt');
        allow delete: if cccStaff();
      }
    }
    function validCccRound(round, d) {
      return d.keys().hasOnly(['round', 'title', 'status', 'deadline', 'closedAt', 'updatedAt'])
        && d.round == round
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.status in ['open', 'closed']
        && optString(d, 'deadline', 20) && optNumber(d, 'closedAt') && optNumber(d, 'updatedAt');
    }
    function validCccEntry(email, d) {
      return d.keys().hasOnly(['email', 'name', 'noProjects', 'projects', 'admin', 'teaching', 'conferences', 'updatedAt'])
        && d.email == email
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && (!('noProjects' in d) || d.noProjects is bool)
        && d.projects is list && d.projects.size() <= 30
        && d.admin is list && d.admin.size() <= 30
        && d.teaching is list && d.teaching.size() <= 30
        && d.conferences is list && d.conferences.size() <= 30
        && d.updatedAt == request.time;
    }
    function validCccMsf(email, d) {
      return d.keys().hasOnly(['email', 'name', 'nominees', 'updatedAt'])
        && d.email == email
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.nominees is list && d.nominees.size() <= 20
        && d.updatedAt == request.time;
    }
  }
}
