{
  "name": "APMES Logbook",
  "short_name": "Logbook",
  "description": "Log anaesthesia cases in seconds and track APMES case targets.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f3f3",
  "theme_color": "#002f6c",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Log a case",
      "short_name": "Log",
      "url": "./#quicklog",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Logbook",
      "short_name": "Logbook",
      "url": "./#logbook",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Today's note",
      "short_name": "Today",
      "url": "./#today",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "New reflection",
      "short_name": "Reflect",
      "url": "./#reflect",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "text/plain",
            "text/markdown",
            ".md",
            ".markdown",
            ".txt"
          ]
        }
      ]
    }
  }
}
