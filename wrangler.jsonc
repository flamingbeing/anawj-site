// Cloudflare Workers config: the PR previews (PREVIEWS.md) and the subdomains (SUBDOMAINS.md). anawj.com itself is
// GitHub Pages and ignores this file. The Worker (worker/sites.js) serves the repo root's files and decides which
// folder each address may see (worker/routes.js). No data, no secrets in this file (the Worker's settings, such as Ask
// Claude's, are set in the Cloudflare dashboard).
{
  "name": "anawj-preview",
  "main": "worker/sites.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // every request goes through the Worker first (it picks the folder by address); it does the folder-index and
    // trailing-slash handling itself, so Cloudflare's own are off
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // previews are off everywhere (repo split, 21 Oct 2026); checks run locally with `npx wrangler@4 dev --local`
  "preview_urls": false,
  // variables set in the Cloudflare dashboard survive each deploy (Ask Claude's settings; edit/NOTES.md). Secrets always do.
  "keep_vars": true,
  // required by `wrangler preview` (Worker Previews), even when empty: previews use the same settings
  "previews": {},
  // Beta: beta-apmes.anawj.com moved to the apmes repo's Worker apmes-beta (21 Oct 2026). This env is kept only so a
  // deploy from the old beta branch still works; it has no address, so it can never take the domain back.
  "env": {
    "beta": {
      "name": "anawj-beta",
      "routes": []
    }
  }
}
