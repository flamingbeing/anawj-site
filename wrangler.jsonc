// Cloudflare Workers config: the PR previews (PREVIEWS.md) and the subdomains (SUBDOMAINS.md). anawj.com itself is
// GitHub Pages and ignores this file. The Worker (worker/sites.js) serves the repo root's files and decides which
// folder each address may see (worker/routes.js). No data, no secrets in this file (the Worker's settings, such as Ask
// Claude's, are set in the Cloudflare dashboard).
{
  "name": "anawj-preview",
  "main": "worker/sites.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // every request goes through the Worker first (it picks the folder by address); it does the folder-index and
    // trailing-slash handling itself, so Cloudflare's own are off
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // a preview link per branch and per build, posted on the PR by Workers Builds
  "preview_urls": true,
  // variables set in the Cloudflare dashboard survive each deploy (Ask Claude's settings; edit/NOTES.md). Secrets always do.
  "keep_vars": true,
  // required by `wrangler preview` (Worker Previews), even when empty: previews use the same settings
  "previews": {},
  // the guest passcode sign-in (worker/guest.js): at most 10 tries a minute per address
  // the passcodes changed on the applicants app's Set up page are read from Firestore (worker/guest.js); both values are public
  // (the web API key is restricted by address, access is by the rules)
  "vars": { "FIREBASE_API_KEY": "AIzaSyDRC7COpi86H0K6oe98XZ8m1sQWJUkP63E", "FIREBASE_PROJECT": "apmes-logbook" },
  "ratelimits": [{ "name": "GUEST_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // Beta (PREVIEWS.md, "Beta"): a second Worker, anawj-beta, deployed from the beta branch by its own Workers Builds
  // (deploy command `npx wrangler deploy --env beta`). It serves beta-apmes.anawj.com only; the apps there use the
  // test Firebase project. No vars: the guest sign-in answers on apmes.anawj.com only (vars and ratelimits are not
  // inherited, so they are listed here).
  "env": {
    "beta": {
      "name": "anawj-beta",
      "routes": [{ "pattern": "beta-apmes.anawj.com", "custom_domain": true }],
      "vars": {},
      "ratelimits": [{ "name": "GUEST_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }]
    }
  }
}
